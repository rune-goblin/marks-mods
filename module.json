{
  "id": "marks-mods",
  "title": "Mark's Mods",
  "description": "A Pathfinder 2e Foundry VTT module template: compendium content plus a scripted esmodule with a Svelte 5 UI mounted in ApplicationV2.",
  "version": "0.1.0",
  "license": "MIT",
  "authors": [
    {
      "name": "Mark Pearce"
    }
  ],
  "esmodules": [
    "dist/marks-mods.js"
  ],
  "styles": [
    "dist/marks-mods.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "socket": true,
  "packs": [
    {
      "name": "macros",
      "label": "Mark's Mods Macros",
      "path": "packs/macros",
      "type": "Macro"
    },
    {
      "name": "effects",
      "label": "Mark's Mods Effects",
      "path": "packs/effects",
      "type": "Item",
      "system": "pf2e"
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "pf2e",
        "type": "system",
        "compatibility": {
          "minimum": "8.0.0"
        }
      }
    ]
  },
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "url": "https://github.com/rune-goblin/marks-mods",
  "manifest": "https://github.com/rune-goblin/marks-mods/releases/latest/download/module.json",
  "download": "https://github.com/rune-goblin/marks-mods/releases/latest/download/marks-mods.zip"
}
